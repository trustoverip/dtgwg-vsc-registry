{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "reg": "{{metaBase}}v1/vocab#",

    "id": "@id",
    "type": "@type",
    "Predicate": "rdf:Property",

    "name": "reg:name",
    "version": { "@id": "reg:version", "@type": "xsd:integer" },
    "status": "reg:status",
    "since": { "@id": "reg:since", "@type": "xsd:date" },
    "deprecatedOn": { "@id": "reg:deprecatedOn", "@type": "xsd:date" },
    "label": { "@id": "rdfs:label", "@container": "@language" },
    "definition": { "@id": "skos:definition", "@container": "@language" },
    "classification": "reg:classification",
    "weighedBy": "reg:weighedBy",
    "objectKind": { "@id": "reg:objectKind", "@container": "@set" },
    "objectSchema": { "@id": "reg:objectSchema", "@type": "@id" },
    "objectSchemaDelegated": { "@id": "reg:objectSchemaDelegated", "@type": "xsd:boolean" },
    "subjectObjectRelationship": "reg:subjectObjectRelationship",
    "additionalMembers": { "@id": "reg:additionalMembers", "@type": "@json" },
    "taskContextRequired": { "@id": "reg:taskContextRequired", "@type": "xsd:boolean" },
    "minimumIssuerScope": "reg:minimumIssuerScope",
    "issuer": "reg:issuer",
    "establishes": "reg:establishes",
    "doesNotEstablish": { "@id": "reg:doesNotEstablish", "@container": "@list" },
    "definedIn": { "@id": "rdfs:isDefinedBy", "@type": "@id" },
    "governedBy": { "@id": "reg:governedBy", "@type": "@id" },
    "supersedes": { "@id": "dcterms:replaces", "@type": "@id" },
    "supersededBy": { "@id": "dcterms:isReplacedBy", "@type": "@id" },
    "convergenceRecord": { "@id": "reg:convergenceRecord", "@type": "@id" },
    "seeAlso": { "@id": "rdfs:seeAlso", "@type": "@id", "@container": "@set" }
  }
}
